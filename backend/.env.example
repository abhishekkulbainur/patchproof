# Copy to backend/.env (never commit .env). All values are optional.
# Without these, PatchProof runs fully in demo mode using deterministic patch templates.

# Optional AI patch proposals (any OpenAI-compatible chat completions endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where SQLite DB and the demo workspace live (default: backend/var)
# PATCHPROOF_DATA_DIR=
